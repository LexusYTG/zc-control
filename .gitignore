# Gradle: caché y archivos temporales
.gradle/
**/.gradle/

# Archivos generados por Gradle
build/
**/build/

# APK y paquetes Android
*.apk
*.aab
*.ap_
*.dex

# Archivos compilados
*.class

# Archivos temporales de Android
local.properties

# Informes y registros de compilación
*.log

# Archivos temporales del sistema
.DS_Store
Thumbs.db

# Archivos temporales de editores
*.tmp
*.swp
*.bak
